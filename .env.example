# Google OAuth Web client ID (not a secret). Create at console.cloud.google.com → APIs & Services → Credentials.
# Authorized JS origins: http://localhost:5173 and your deploy URL. Enable "Google Calendar API".
VITE_GOOGLE_CLIENT_ID=

# Supabase (accounts + sync). Both values are public; data is protected by row-level security.
# NEVER put the service_role key in this app or in .env files that get bundled.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
